{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embedaiassist.s11.analysis.v1",
  "title": "S11 现象分析结果",
  "type": "object",
  "required": ["schema_version", "analysis_id", "summary", "user_observation", "findings", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "analysis_id": { "type": "string" },
    "summary": { "type": "string" },
    "user_observation": { "type": ["string", "null"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "kind", "observation", "evidence_ids", "limitations"],
        "properties": {
          "finding_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["error", "warning", "normal_event", "repeated_pattern", "event_order", "missing_expected_event", "other"] },
          "observation": { "type": "string" },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "occurrence_count": { "type": ["integer", "null"], "minimum": 1 },
          "time_range": { "type": ["string", "null"] },
          "limitations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
