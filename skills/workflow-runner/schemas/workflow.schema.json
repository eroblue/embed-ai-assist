{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "name", "project_config", "build_target", "steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "project_config": {"type": "string", "minLength": 1},
    "build_target": {"enum": ["App", "BootLoader"]},
    "steps": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "skill", "enabled", "params"],
      "properties": {
        "id": {"type": "string"}, "skill": {"type": "string"},
        "enabled": {"type": "boolean"}, "params": {"type": "object"}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
