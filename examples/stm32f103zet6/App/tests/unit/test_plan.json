      "cases": [
        {"id": "uart_init_ready", "scenario": "初始化上报口", "expected": "115200-8N1配置且就绪", "expected_basis": "App/Inc/app_uart_report.h"},
        {"id": "before_period_no_write", "scenario": "推进499个10ms节拍", "expected": "未发送", "expected_basis": "docs/flow/app_uart_report_sequence.md"},
