{
  "units": [
    {
      "id": "App/Src/app_mode_control",
      "source": "App/Src/app_mode_control.c",
      "status": "ready",
      "test_source": "tests/unit/test_app_mode_control.c",
      "include_dirs": ["App/Inc"],
      "cases": [
        {"id": "mode_initial", "scenario": "initialize module", "expected": "AUTO, unmuted, display AUTO", "expected_basis": "docs/flow/app_mode_control_state.md: approved initial AUTO state"},
        {"id": "mode_toggle", "scenario": "press mode key once", "expected": "MANUAL and display MANUAL", "expected_basis": "App/Inc/app_mode_control.h: mode key switches AUTO/MANUAL"},
        {"id": "mute_independent", "scenario": "press mute key while in MANUAL", "expected": "mode remains MANUAL, muted, display MUTED", "expected_basis": "docs/flow/app_mode_control_state.md: mute overlays mode and restores display"}
      ]
    },
    {
      "id": "App/Src/app_env_sensor",
      "source": "App/Src/app_env_sensor.c",
      "status": "ready",
      "test_source": "tests/unit/test_app_env_sensor.c",
      "mocks": ["tests/unit/mocks/mock_env_interfaces.c"],
      "include_dirs": ["App/Inc", "Drivers/BSP/Inc", "Drivers/Port/Inc", "tests/unit/mocks"],
      "cases": [
        {"id": "initial_fault", "scenario": "initialize with no sensor reading", "expected": "fault set, one fault event, no read", "expected_basis": "App/Inc/app_env_sensor.h and approved docs/flow/app_env_sensor_flow.md: no valid reading is fault"},
        {"id": "first_valid_recovery", "scenario": "mock 25C/60% and 1650mV, advance 200 ticks", "expected": "fault cleared, one recovery event, temperature 25, humidity 60, light 50%", "expected_basis": "approved docs/flow/app_env_sensor_flow.md: 2s period, first success recovers and updates data"},
        {"id": "read_failure_retains", "scenario": "mock DHT timeout after a valid sample, advance 200 ticks", "expected": "last temperature and humidity retained, no fault yet", "expected_basis": "approved docs/flow/app_env_sensor_flow.md: read failure retains last valid data"}
      ]
    },
    {
      "id": "App/Src/app_alarm_control", "source": "App/Src/app_alarm_control.c", "status": "ready",
      "test_source": "tests/unit/test_app_alarm_control.c",
      "include_dirs": ["App/Inc", "Drivers/Port/Inc"],
      "cases": [
        {"id": "alarm_init", "scenario": "初始化告警控制", "expected": "NORMAL，执行器关闭", "expected_basis": "App/Inc/app_alarm_control.h"},
        {"id": "high_temp_actuator", "scenario": "自动模式、温度31°C", "expected": "高温告警，执行器开启", "expected_basis": "docs/flow/app_alarm_control_state.md"},
        {"id": "low_temp_actuator", "scenario": "温度降至9°C", "expected": "低温告警，执行器关闭", "expected_basis": "docs/flow/app_alarm_control_state.md"},
        {"id": "sensor_fault_silent", "scenario": "发布传感器故障事件", "expected": "进入故障态，蜂鸣关闭", "expected_basis": "App/Inc/app_alarm_control.h 与 S5b 已确认的代码契约"},
        {"id": "sensor_recovered", "scenario": "故障后发布恢复事件", "expected": "恢复 NORMAL", "expected_basis": "App/Inc/app_alarm_control.h"}
      ]
    },
    {
