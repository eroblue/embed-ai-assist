      "id": "App/Src/app", "source": "App/Src/app.c", "status": "ready",
      "test_source": "tests/unit/test_app.c",
      "include_dirs": ["App/Inc", "Drivers/Port/Inc"],
      "cases": [
        {"id": "app_init_order", "scenario": "全部依赖初始化成功", "expected": "按定时器、模式、按键、告警、采集、串口、显示、运行灯、看门狗的顺序初始化", "expected_basis": "App/Inc/app.h 与 docs/s5b_design_input.md"},
        {"id": "output_soft_failure", "scenario": "串口和显示初始化失败", "expected": "软失败不阻断 app_init", "expected_basis": "App/Src/app.c 的软失败设计说明"},
        {"id": "sensor_init_failure", "scenario": "采集模块初始化返回超时", "expected": "向上返回错误，跳过后续输出模块初始化", "expected_basis": "App/Inc/app.h 与 App/Src/app.c 的初始化约定"}
      ]
    },
    {
      "id": "App/Src/app_lcd_display", "source": "App/Src/app_lcd_display.c", "status": "ready",
