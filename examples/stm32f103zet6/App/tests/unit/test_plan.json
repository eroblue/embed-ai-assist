        {"id": "normal_render", "scenario": "第20拍读取环境与状态", "expected": "写入四行约定文本", "expected_basis": "docs/flow/app_lcd_display_flow.md"},
        {"id": "alarm_dark_phase", "scenario": "高温告警后的下一刷新", "expected": "告警行隐藏", "expected_basis": "App/Inc/app_lcd_display.h"},
        {"id": "alarm_light_phase", "scenario": "再下一刷新", "expected": "告警行重新显示", "expected_basis": "App/Inc/app_lcd_display.h"}
      ]
    },
